FROM python:3.12-slim-bookworm

WORKDIR /app

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Layer 1: Python deps — cached until requirements/pyproject change (not on every etl/*.py edit)
COPY pyproject.toml README.md ./
COPY etl/requirements.txt ./etl/requirements.txt

RUN pip install --no-cache-dir --upgrade pip \
  && pip install --no-cache-dir -r etl/requirements.txt

# Layer 2: application code — fast reinstall of the local package only
COPY etl ./etl

RUN pip install --no-cache-dir --no-deps .

EXPOSE 8000

CMD ["sh", "-c", "uvicorn etl.http_service:app --host 0.0.0.0 --port ${PORT:-8000}"]
